{
  "name": "obsidian-ai-transcriber",
  "version": "0.10.1",
  "description": "Transcribe audio and video files with OpenAI transcription models",
  "main": "main.js",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "tsc --noEmit && node esbuild-api.config.mjs production",
    "build:debug": "tsc --noEmit && node esbuild-api.config.mjs",
    "dev": "tsc --noEmit && node esbuild-api.config.mjs --watch",
    "build:release": "npm run check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:long-form:generate": "bash scripts/generate-long-form-test-audio.sh",
    "test:long-form:verify": "node scripts/verify-long-form-transcript.mjs",
    "test:long-form:verifier": "node --test scripts/verify-long-form-transcript.test.mjs",
    "test:community": "jest tests/community --runInBand",
    "lint": "eslint \"src/**/*.ts\" package.json --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" package.json --fix",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "verify:metadata": "node scripts/verify-community-metadata.mjs",
    "check": "npm run lint && npm run build && npm test -- --runInBand --coverage"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "gpt-transcribe",
    "whisper",
    "transcription",
    "speech-to-text",
    "japanese"
  ],
  "author": "Musashino Software",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "esbuild": "0.28.1",
    "eslint": "^9.12.0",
    "eslint-plugin-depend": "^1.3.1",
    "eslint-plugin-import-x": "^4.13.0",
    "eslint-plugin-json-schema-validator": "^5.1.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "eslint-plugin-security": "^2.1.1",
    "globals": "^14.0.0",
    "jest": "^30.0.2",
    "obsidian": "1.13.0",
    "ts-jest": "^29.4.0",
    "tslib": "2.4.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@echogarden/fvad-wasm": "^0.2.0"
  }
}
