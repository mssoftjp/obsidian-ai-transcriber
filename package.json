{
  "name": "obsidian-ai-transcriber",
  "version": "0.11.5",
  "description": "Transcribe audio and video files with OpenAI transcription models",
  "main": "main.js",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "tsc --noEmit && node esbuild-api.config.mjs production",
    "build:debug": "tsc --noEmit && node esbuild-api.config.mjs",
    "dev": "tsc --noEmit && node esbuild-api.config.mjs --watch",
    "build:release": "npm run check:community",
    "postinstall": "patch-package --error-on-fail",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:long-form:generate": "bash scripts/generate-long-form-test-audio.sh",
    "test:long-form:verify": "node scripts/verify-long-form-transcript.mjs",
    "test:long-form:verifier": "node --test scripts/verify-long-form-transcript.test.mjs",
    "test:dependency-compat": "node --test scripts/brace-expansion-compat.test.mjs",
    "test:local-deploy": "node --test scripts/deploy-to-obsidian.test.mjs",
    "test:community": "jest tests/community --runInBand",
    "lint": "eslint \"src/**/*.ts\" package.json --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" package.json --fix",
    "lint:artifacts": "eslint \"build/**/*.js\" --max-warnings=0",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify:metadata": "node scripts/verify-community-metadata.mjs",
    "verify:release": "node scripts/verify-community-release.mjs",
    "verify:community": "npm run verify:metadata && npm run verify:release",
    "check": "npm run check:community",
    "check:community": "npm run lint && npm run build && npm run verify:community && npm run lint:artifacts && npm run typecheck:test && npm run test:dependency-compat && npm run test:local-deploy && npm test -- --runInBand --coverage",
    "test:media": "playwright test"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "gpt-transcribe",
    "whisper",
    "transcription",
    "speech-to-text",
    "japanese"
  ],
  "author": "Musashino Software",
  "license": "MIT",
  "engines": {
    "node": "20 || >=22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-depend": "^1.3.1",
    "eslint-plugin-import-x": "^4.13.0",
    "eslint-plugin-json-schema-validator": "^5.1.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "eslint-plugin-security": "^2.1.1",
    "globals": "17.6.0",
    "jest": "^30.0.2",
    "obsidian": "1.13.0",
    "patch-package": "8.0.1",
    "ts-jest": "^29.4.0",
    "tslib": "2.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion"
  },
  "dependencies": {
    "@echogarden/fvad-wasm": "^0.2.0"
  }
}
